GREENROUTE_MOCK_BEDROCK=true          # false = call AWS Bedrock
GREENROUTE_AWS_REGION=eu-north-1
GREENROUTE_TIERS_FILE=config/tiers.yaml
GREENROUTE_CARBON_ZONE=SE-SE3         # SE-SE1..SE-SE4
GREENROUTE_ELECTRICITYMAPS_TOKEN=     # empty = synthetic carbon curve
GREENROUTE_JUDGE_ENABLED=true
GREENROUTE_JUDGE_TIER=1
GREENROUTE_QUALITY_THRESHOLD=7
GREENROUTE_PUE=1.15
GREENROUTE_REDIS_URL=                 # empty = in-memory job store (single replica only)
GREENROUTE_DEFAULT_DEADLINE_HOURS=24
