{
  "uid": "greenroute",
  "title": "GreenRoute: carbon-aware LLM routing",
  "tags": [
    "greenroute",
    "llm",
    "sustainability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CO2e per request",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "decimals": 5
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(greenroute_co2_grams_total{workload=~\"interactive|batch\"}[$__range])) / sum(increase(greenroute_requests_total{workload=~\"interactive|batch\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
